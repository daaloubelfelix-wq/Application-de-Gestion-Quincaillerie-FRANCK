/*
  Feuille de style de l'application — appliquée globalement (voir main.py).
  Palette industrielle : fond papier chaud, acier pour la structure,
  ambre pour l'action principale — cohérente avec les documents du projet.
*/

* {
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
    color: #22262B;
}

QWidget {
    background-color: #F3F1EC;
}

/* Les étiquettes ne doivent jamais peindre leur propre fond : sinon elles
   affichent un rectangle de la couleur ci-dessus par-dessus la carte ou
   l'illustration qui les contient. */
QLabel {
    background: transparent;
}

/* ---------- Boutons ---------- */
QPushButton {
    background-color: #B8710F;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #A3620C;
}
QPushButton:pressed {
    background-color: #8C540A;
}
QPushButton:disabled {
    background-color: #D9D2C2;
    color: #8A8577;
}

/* Bouton secondaire (contour, sans fond plein) — voir setProperty("secondaire", True) */
QPushButton[secondaire="true"] {
    background-color: #FBFAF7;
    color: #3D5066;
    border: 1px solid #C7BFAB;
}
QPushButton[secondaire="true"]:hover {
    background-color: #EFEAE0;
}

/* ---------- Champs de saisie ---------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #DDD7C9;
    border-radius: 6px;
    padding: 6px 10px;
    selection-background-color: #B8710F;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #B8710F;
}

/* ---------- Onglets ---------- */
QTabWidget::pane {
    border-top: 1px solid #DDD7C9;
    background-color: #F3F1EC;
}
QTabBar::tab {
    background-color: #EAE5D7;
    color: #5B6169;
    padding: 9px 20px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background-color: #F3F1EC;
    color: #22262B;
    font-weight: 600;
    border-bottom: 2px solid #B8710F;
}
QTabBar::tab:hover:!selected {
    background-color: #F1EBDD;
}

/* ---------- Tableaux et listes ---------- */
QTableWidget, QListWidget {
    background-color: #FBFAF7;
    border: 1px solid #DDD7C9;
    border-radius: 6px;
    gridline-color: #EDE8DB;
}
QHeaderView::section {
    background-color: #E4E9EE;
    color: #3D5066;
    padding: 6px 8px;
    border: none;
    font-weight: 600;
}
QTableWidget::item:selected, QListWidget::item:selected {
    background-color: #F3E2B8;
    color: #22262B;
}

/* ---------- Rôles sémantiques (voir objectName sur les widgets) ---------- */
QLabel#titreEcran {
    font-size: 17px;
    font-weight: 700;
    color: #22262B;
}
QLabel#titreSection {
    font-size: 13px;
    font-weight: 700;
    color: #3D5066;
}
QLabel#texteAttenue {
    color: #5B6169;
    font-size: 12px;
}
QLabel#totalMisEnValeur {
    font-size: 17px;
    font-weight: 700;
    color: #22262B;
}
QFrame#carteTotaux {
    background-color: #EAE5D7;
    border-radius: 8px;
    padding: 12px;
}

QDialog {
    background-color: #F3F1EC;
}

/* Bouton "œil" de visibilité du mot de passe (formulaires en thème clair) */
QPushButton#boutonOeil {
    background-color: #FFFFFF;
    border: 1px solid #DDD7C9;
    border-radius: 6px;
    padding: 0;
}
QPushButton#boutonOeil:hover {
    background-color: #F1EBDD;
}
QPushButton#boutonOeil:checked {
    background-color: #F3E2B8;
    border: 1px solid #B8710F;
}

/* ---------- Écran d'accueil et de connexion (thème sombre) ---------- */
QScrollArea#defilementAccueil {
    background-color: #17212C;
    border: none;
}
QWidget#ecranAccueil {
    background-color: #17212C;
}
QWidget#ecranAccueil QLabel {
    color: #E7ECF1;
}

QWidget#enteteAccueil {
    background-color: #121A23;
    border-bottom: 1px solid #232F3B;
}
QLabel#logoAccueil {
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
}
QLabel#sloganAccueil {
    color: #8FA0AF;
    font-size: 11px;
}

QWidget#heroAccueil {
    background-color: #17212C;
}
QWidget#colonneTexteHero {
    background-color: transparent;
}
QLabel#titreHero {
    font-size: 27px;
    font-weight: 800;
    color: #FFFFFF;
}
QLabel#sousTitreHero {
    color: #AAB8C4;
    font-size: 13px;
}
QFrame#cadrePhoto {
    background-color: transparent;
}

QFrame#carteConnexionHero {
    background-color: #1F2B38;
    border: 1px solid #33465A;
    border-radius: 12px;
}
QLabel#titreCarteConnexion {
    font-size: 15px;
    font-weight: 700;
    color: #FFFFFF;
}
QFrame#carteConnexionHero QLineEdit {
    background-color: #17212C;
    border: 1px solid #33465A;
    color: #FFFFFF;
    selection-background-color: #E8A23A;
}
QFrame#carteConnexionHero QLineEdit:focus {
    border: 1px solid #E8A23A;
}
QPushButton#boutonConnexionHero {
    background-color: #E8A23A;
    color: #17212C;
    padding: 10px 16px;
    font-size: 13px;
}
QPushButton#boutonConnexionHero:hover {
    background-color: #F0B458;
}
QPushButton#boutonConnexionHero:pressed {
    background-color: #D08F2E;
}
QPushButton#boutonOeilHero {
    background-color: #17212C;
    border: 1px solid #33465A;
    border-radius: 6px;
    padding: 0;
}
QPushButton#boutonOeilHero:hover {
    background-color: #26364A;
}
QPushButton#boutonOeilHero:checked {
    background-color: #2C3B4A;
    border: 1px solid #E8A23A;
}
QLabel#texteErreurHero {
    color: #FF8A65;
    font-size: 12px;
}
QLabel#texteAideHero {
    color: #7C8B99;
    font-size: 11px;
}

QWidget#sectionFonctionnalites {
    background-color: #17212C;
}
QFrame#carteFonctionnalite {
    background-color: #1F2B38;
    border: 1px solid #2C3B4A;
    border-radius: 10px;
}
QLabel#titreCarteFonctionnalite {
    font-size: 13px;
    font-weight: 700;
    color: #FFFFFF;
}
QLabel#texteCarteFonctionnalite {
    color: #97A6B4;
    font-size: 11px;
}

QFrame#piedAccueil {
    background-color: #121A23;
    border-top: 1px solid #232F3B;
}
QLabel#texteFooterAccueil {
    color: #7C8B99;
    font-size: 11px;
}
QLabel#contactAccueil {
    color: #E8A23A;
    font-weight: 700;
    font-size: 12px;
}
